---
import '~/styles/tailwind.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Top Tier Legal PLLC — White Plains, Westchester County, NY', description = 'Trusted legal counsel in the New York Tri-State Area. Business law, real estate, estate planning.' } = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body class="min-h-screen bg-stone-50 text-stone-800 antialiased" style="font-family: 'Inter', system-ui, sans-serif;">
		<slot />
	</body>
</html>
