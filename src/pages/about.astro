---
import TopTierLegalLayout from '~/layouts/TopTierLegalLayout.astro';
import TopTierLegalNav from './toptierlegal/_components/TopTierLegalNav.astro';
import TopTierLegalFooter from './toptierlegal/_components/TopTierLegalFooter.astro';
---
<TopTierLegalLayout title="About — Top Tier Legal PLLC" description="About Top Tier Legal PLLC. Serving White Plains, Westchester County, NY with business law, real estate, and estate planning.">
	<TopTierLegalNav base="" />
	<main class="min-h-screen">
		<section class="border-b border-stone-200 bg-white px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
			<div class="mx-auto max-w-3xl">
				<h1 class="text-3xl font-semibold tracking-tight text-stone-900 sm:text-4xl" style="font-family: 'Cormorant Garamond', serif;">About Top Tier Legal PLLC</h1>
				<p class="mt-4 text-stone-600 leading-relaxed">
					Assisting clients with business formation, contract review, compliance matters, and dispute resolution to support smooth and lawful operations.
				</p>
				<p class="mt-2 text-sm text-stone-500">Service area: White Plains, Westchester County, NY</p>

				<h2 class="mt-12 text-xl font-semibold text-stone-900" style="font-family: 'Cormorant Garamond', serif;">Our Story</h2>
				<p class="mt-3 text-stone-600 leading-relaxed">
					Top Tier Legal PLLC was founded to deliver dependable legal services to the New York tri-state community. Our team is driven by a dedication to clear communication and practical solutions that address real-world challenges faced by our clients.
				</p>

				<h2 class="mt-10 text-xl font-semibold text-stone-900" style="font-family: 'Cormorant Garamond', serif;">Our Mission</h2>
				<p class="mt-3 text-stone-600 leading-relaxed">
					Our mission is to provide accessible, effective legal representation that supports the goals and protects the interests of our clients throughout the tri-state area.
				</p>

				<h2 class="mt-10 text-xl font-semibold text-stone-900" style="font-family: 'Cormorant Garamond', serif;">Why Choose Us</h2>
				<ul class="mt-3 list-disc space-y-2 pl-5 text-stone-600">
					<li>Offers a broad range of legal services including business, real estate, and estate planning</li>
					<li>Focused on clear and practical legal advice tailored to client needs</li>
					<li>Located in White Plains with deep knowledge of local laws and regulations</li>
				</ul>

				<div class="mt-12 border-t border-stone-200 pt-8">
					<p class="text-sm font-medium text-stone-700">Top Tier Legal PLLC</p>
					<p class="mt-1 text-sm text-stone-600">24 Heatherbloom Road White Plains, NY 10605</p>
					<p class="mt-1 text-sm text-stone-600">
						<a href="mailto:clientcare@toptierlegalpllc.nebulabrandgroup.com" class="hover:underline">clientcare@toptierlegalpllc.nebulabrandgroup.com</a>
						<span class="text-stone-400">·</span>
						<a href="tel:+18455960430" class="hover:underline">(845) 596-0430</a>
					</p>
				</div>
			</div>
		</section>
	</main>
	<TopTierLegalFooter base="" contactEmail="clientcare@toptierlegalpllc.nebulabrandgroup.com" />
</TopTierLegalLayout>
