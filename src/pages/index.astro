---
import TopTierLegalLayout from '~/layouts/TopTierLegalLayout.astro';
import TopTierLegalNav from './toptierlegal/_components/TopTierLegalNav.astro';
import TopTierLegalFooter from './toptierlegal/_components/TopTierLegalFooter.astro';
---
<TopTierLegalLayout>
	<TopTierLegalNav base="" />

	<main>
		<!-- Hero with background image, white text, overlay logo -->
		<section id="home" class="relative min-h-[28rem] overflow-hidden px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
			<!-- Dark blue/purple gradient (optionally replace with hero image + overlay) -->
			<div class="absolute inset-0 bg-gradient-to-br from-slate-800 via-indigo-900 to-slate-800" aria-hidden="true" />
			<div class="relative mx-auto max-w-4xl">
				<div class="absolute left-0 top-8 opacity-40">
					<img src="https://toptierlegalpllc.nebulabrandgroup.com/logo.png" alt="" class="h-16 w-auto object-contain" onerror="this.style.display='none'" />
				</div>
				<div class="max-w-3xl text-center pt-12 sm:pt-16">
					<h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl" style="font-family: 'Cormorant Garamond', serif;">
						Trusted Legal Counsel in the New York Tri-State Area
					</h1>
					<p class="mt-4 text-white/90 text-sm sm:text-base">
						Top Tier Legal PLLC • Serving White Plains, Westchester County, NY • Updated 02/21/2026
					</p>
					<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
						<a href="tel:+18455960430" class="inline-flex items-center justify-center rounded-full bg-indigo-600 px-6 py-3 text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2 focus:ring-offset-transparent">
							Call
						</a>
						<a href="#contact-form" class="inline-flex items-center justify-center rounded-full border-2 border-white bg-white/10 px-6 py-3 text-sm font-medium text-white hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-transparent">
							Sign Up For Info
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Two-column cards: Contact (left), About + Services (right) -->
		<section class="border-b border-stone-200 bg-stone-50/50 px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
			<div class="mx-auto max-w-6xl">
				<div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
					<!-- Contact card (left) -->
					<div id="contact" class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
						<h2 class="text-2xl font-semibold text-stone-900 sm:text-3xl" style="font-family: 'Cormorant Garamond', serif;">Contact</h2>
						<dl class="mt-5 space-y-3 text-sm">
							<div>
								<dt class="font-medium text-stone-500">Email</dt>
								<dd><a href="mailto:clientcare@toptierlegalpllc.nebulabrandgroup.com" class="text-stone-900 hover:underline">clientcare@toptierlegalpllc.nebulabrandgroup.com</a></dd>
							</div>
							<div>
								<dt class="font-medium text-stone-500">Phone</dt>
								<dd><a href="tel:+18455960430" class="text-stone-900 hover:underline">(845) 596-0430</a></dd>
							</div>
							<div>
								<dt class="font-medium text-stone-500">Address</dt>
								<dd class="text-stone-700">24 Heatherbloom Road White Plains, NY 10605</dd>
							</div>
						</dl>
						<a href="https://www.google.com/maps/search/?api=1&query=24%20Heatherbloom%20Road%20White%20Plains%2C%20NY%2010605" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-indigo-600 px-6 py-3 text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2">
							<svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
							Get Directions
						</a>
					</div>

					<!-- About + Services cards (right) -->
					<div class="flex flex-col gap-6 lg:gap-8">
						<div id="about" class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
							<h2 class="text-2xl font-semibold text-stone-900 sm:text-3xl" style="font-family: 'Cormorant Garamond', serif;">About</h2>
							<p class="mt-4 text-stone-600 leading-relaxed text-sm sm:text-base">
								Assisting clients with business formation, contract review, compliance matters, and dispute resolution to support smooth and lawful operations.
							</p>
							<a href="/about" class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-stone-900 hover:underline">
								Learn more
								<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
							</a>
						</div>
						<div id="services" class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
							<h2 class="text-2xl font-semibold text-stone-900 sm:text-3xl" style="font-family: 'Cormorant Garamond', serif;">Services</h2>
							<div class="mt-5 space-y-4">
								<div class="rounded-xl border border-stone-200 bg-stone-50/80 p-4">
									<h3 class="font-semibold text-stone-900">Business Law</h3>
									<p class="mt-2 text-sm text-stone-600 leading-relaxed">
										Assisting clients with business formation, contract review, compliance matters, and dispute resolution to support smooth and lawful operations.
									</p>
								</div>
								<div class="rounded-xl border border-stone-200 bg-stone-50/80 p-4">
									<h3 class="font-semibold text-stone-900">Real Estate Law</h3>
									<p class="mt-2 text-sm text-stone-600 leading-relaxed">
										Providing legal support for residential and commercial real estate transactions, including contract drafting, negotiations, and title issues.
									</p>
								</div>
								<div class="rounded-xl border border-stone-200 bg-stone-50/80 p-4">
									<h3 class="font-semibold text-stone-900">Estate Planning</h3>
									<p class="mt-2 text-sm text-stone-600 leading-relaxed">
										Helping clients develop wills, trusts, and other estate planning documents to ensure their assets are managed and distributed according to their wishes.
									</p>
								</div>
							</div>
							<a href="/services" class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-stone-900 hover:underline">
								View all services
								<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Request Information Form -->
		<section id="contact-form" class="bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
			<div class="mx-auto max-w-xl">
				<h2 class="text-2xl font-semibold text-stone-900 sm:text-3xl" style="font-family: 'Cormorant Garamond', serif;">Request Information</h2>
				<p class="mt-2 text-stone-600">
					Contact us to learn more about our legal services and how we can assist with your specific legal needs.
				</p>
				<form id="request-info-form" class="mt-8 space-y-6" action="#" method="post">
					<div>
						<label for="name" class="block text-sm font-medium text-stone-700">Full Name *</label>
						<input type="text" id="name" name="name" required class="mt-1 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-900 shadow-sm focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500" />
					</div>
					<div>
						<label for="email" class="block text-sm font-medium text-stone-700">Email Address *</label>
						<input type="email" id="email" name="email" required class="mt-1 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-900 shadow-sm focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500" />
					</div>
					<div>
						<label for="phone" class="block text-sm font-medium text-stone-700">Mobile Phone Number (Optional)</label>
						<input type="tel" id="phone" name="phone" class="mt-1 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-900 shadow-sm focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500" />
					</div>
					<div class="space-y-4">
						<label class="flex gap-3">
							<input type="checkbox" name="consent_status" class="h-4 w-4 rounded border-stone-300 text-stone-900 focus:ring-stone-500" />
							<span class="text-sm text-stone-600">
								I consent to receive <strong>non-marketing messages about case status updates, legal document notifications, and responses to general inquiries</strong> from <strong>Top Tier Legal PLLC</strong>. Message frequency varies, up to 4 messages per month. Message & data rates may apply. Text HELP for assistance, reply STOP to opt out.
							</span>
						</label>
						<label class="flex gap-3">
							<input type="checkbox" name="consent_promo" class="h-4 w-4 rounded border-stone-300 text-stone-900 focus:ring-stone-500" />
							<span class="text-sm text-stone-600">
								I consent to receive <strong>promotional notifications about updates on legal service offerings, changes in local laws, and educational content about legal rights and responsibilities</strong> from <strong>Top Tier Legal PLLC</strong> at the phone number provided. Message frequency varies, up to 4 messages per month. Message & data rates may apply. Text HELP for assistance, reply STOP to opt out.
							</span>
						</label>
					</div>
					<p class="text-xs text-stone-500">
						<a href="/privacy" class="hover:underline">Privacy Policy</a> · <a href="/terms" class="hover:underline">Terms of Service</a>
					</p>
					<button type="submit" class="w-full rounded-full bg-indigo-600 px-6 py-3 text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2">
						Submit
					</button>
				</form>
			</div>
		</section>
	</main>

	<TopTierLegalFooter base="" contactEmail="clientcare@toptierlegalpllc.nebulabrandgroup.com" />

	<!-- Thank You modal (matches toptierlegalpllc.nebulabrandgroup.com) -->
	<div id="thank-you-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4" aria-hidden="true" aria-modal="true" role="dialog">
		<div class="relative w-full max-w-md rounded-lg border border-stone-200 bg-white p-6 shadow-xl text-center">
			<p class="text-lg font-semibold text-stone-900" style="font-family: 'Cormorant Garamond', serif;">Top Tier Legal PLLC</p>
			<h3 class="mt-4 text-xl font-semibold text-stone-900" style="font-family: 'Cormorant Garamond', serif;">Thank You!</h3>
			<p class="mt-3 text-sm text-stone-600">
				<strong>Top Tier Legal PLLC</strong> will reach out within 24 hours by phone or text if you opted in.
			</p>
			<p class="mt-2 text-sm text-stone-600">
				If you opted in for SMS, you can opt out any time by replying <strong>STOP</strong>. For help, reply <strong>HELP</strong>.
			</p>
			<button type="button" id="thank-you-close" class="mt-6 w-full rounded-full bg-stone-900 px-6 py-3 text-sm font-medium text-white hover:bg-stone-800">
				Got it
			</button>
		</div>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const form = document.querySelector('#request-info-form');
			const modal = document.getElementById('thank-you-modal');
			const closeBtn = document.getElementById('thank-you-close');
			if (!form || !modal || !closeBtn) return;
			form.addEventListener('submit', (e) => {
				e.preventDefault();
				modal.classList.remove('hidden');
				modal.classList.add('flex');
				modal.setAttribute('aria-hidden', 'false');
			});
			function closeModal() {
				modal.classList.add('hidden');
				modal.classList.remove('flex');
				modal.setAttribute('aria-hidden', 'true');
			}
			closeBtn.addEventListener('click', closeModal);
			modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
		});
	</script>
</TopTierLegalLayout>
