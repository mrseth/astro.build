---
import TopTierLegalLayout from '~/layouts/TopTierLegalLayout.astro';
import TopTierLegalNav from './_components/TopTierLegalNav.astro';
import TopTierLegalFooter from './_components/TopTierLegalFooter.astro';
---
<TopTierLegalLayout title="Contact — Top Tier Legal PLLC" description="Contact Top Tier Legal PLLC. Request information about legal services in White Plains, Westchester County, NY.">
	<TopTierLegalNav />
	<main class="min-h-screen">
		<section class="border-b border-stone-200 bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
			<div class="mx-auto max-w-xl">
				<h1 class="text-3xl font-semibold tracking-tight text-stone-900 sm:text-4xl" style="font-family: 'Cormorant Garamond', serif;">Request Information</h1>
				<p class="mt-2 text-stone-600">
					Contact us to learn more about our legal services and how we can assist with your specific legal needs.
				</p>
				<form class="mt-8 space-y-6" action="#" method="post">
					<div>
						<label for="name" class="block text-sm font-medium text-stone-700">Full Name *</label>
						<input type="text" id="name" name="name" required class="mt-1 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-900 shadow-sm focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500" />
					</div>
					<div>
						<label for="email" class="block text-sm font-medium text-stone-700">Email Address *</label>
						<input type="email" id="email" name="email" required class="mt-1 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-900 shadow-sm focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500" />
					</div>
					<div>
						<label for="phone" class="block text-sm font-medium text-stone-700">Mobile Phone Number (Optional)</label>
						<input type="tel" id="phone" name="phone" class="mt-1 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-900 shadow-sm focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500" />
					</div>
					<div>
						<label for="message" class="block text-sm font-medium text-stone-700">Message</label>
						<textarea id="message" name="message" rows="4" class="mt-1 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-900 shadow-sm focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"></textarea>
					</div>
					<div class="space-y-4">
						<label class="flex gap-3">
							<input type="checkbox" name="consent_status" class="h-4 w-4 rounded border-stone-300 text-stone-900 focus:ring-stone-500" />
							<span class="text-sm text-stone-600">
								I consent to receive <strong>non-marketing messages about case status updates, legal document notifications, and responses to general inquiries</strong> from <strong>Top Tier Legal PLLC</strong>. Message frequency varies, up to 4 messages per month. Message & data rates may apply. Text HELP for assistance, reply STOP to opt out.
							</span>
						</label>
						<label class="flex gap-3">
							<input type="checkbox" name="consent_promo" class="h-4 w-4 rounded border-stone-300 text-stone-900 focus:ring-stone-500" />
							<span class="text-sm text-stone-600">
								I consent to receive <strong>promotional notifications about updates on legal service offerings, changes in local laws, and educational content about legal rights and responsibilities</strong> from <strong>Top Tier Legal PLLC</strong> at the phone number provided. Message frequency varies, up to 4 messages per month. Message & data rates may apply. Text HELP for assistance, reply STOP to opt out.
							</span>
						</label>
					</div>
					<p class="text-xs text-stone-500">
						<a href="/toptierlegal/privacy" class="hover:underline">Privacy Policy</a> · <a href="/toptierlegal/terms" class="hover:underline">Terms of Service</a>
					</p>
					<button type="submit" class="w-full rounded-full bg-stone-900 px-6 py-3 text-sm font-medium text-white hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-stone-500 focus:ring-offset-2">
						Submit
					</button>
				</form>
			</div>
		</section>

		<section class="border-b border-stone-200 bg-stone-50/50 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
			<div class="mx-auto max-w-5xl">
				<h2 class="text-2xl font-semibold text-stone-900 sm:text-3xl" style="font-family: 'Cormorant Garamond', serif;">Contact info</h2>
				<dl class="mt-6 grid gap-8 sm:grid-cols-2">
					<div>
						<dt class="text-sm font-medium text-stone-500">Email</dt>
						<dd><a href="mailto:clientcare@toptierlegalpllc.com" class="text-stone-900 hover:underline">clientcare@toptierlegalpllc.com</a></dd>
					</div>
					<div>
						<dt class="text-sm font-medium text-stone-500">Phone</dt>
						<dd><a href="tel:+18455960430" class="text-stone-900 hover:underline">(845) 596-0430</a></dd>
					</div>
					<div>
						<dt class="text-sm font-medium text-stone-500">Address</dt>
						<dd>24 Heatherbloom Road White Plains, NY 10605</dd>
					</div>
					<div>
						<dt class="text-sm font-medium text-stone-500">Hours</dt>
						<dd class="text-stone-600">—</dd>
					</div>
				</dl>

				<h3 class="mt-12 text-lg font-semibold text-stone-900" style="font-family: 'Cormorant Garamond', serif;">What to Expect</h3>
				<ul class="mt-3 list-disc space-y-1 pl-5 text-stone-600">
					<li>No obligation to proceed</li>
					<li>Free consultation</li>
					<li>Response within 24 hours</li>
				</ul>

				<h3 class="mt-10 text-lg font-semibold text-stone-900" style="font-family: 'Cormorant Garamond', serif;">Our Services</h3>
				<div class="mt-6 grid gap-6 sm:grid-cols-3">
					<div class="rounded-lg border border-stone-200 bg-white p-4">
						<h4 class="font-semibold text-stone-900">Business Law</h4>
						<p class="mt-2 text-sm text-stone-600">Assisting clients with business formation, contract review, compliance matters, and dispute resolution to support smooth and lawful operations.</p>
					</div>
					<div class="rounded-lg border border-stone-200 bg-white p-4">
						<h4 class="font-semibold text-stone-900">Real Estate Law</h4>
						<p class="mt-2 text-sm text-stone-600">Providing legal support for residential and commercial real estate transactions, including contract drafting, negotiations, and title issues.</p>
					</div>
					<div class="rounded-lg border border-stone-200 bg-white p-4">
						<h4 class="font-semibold text-stone-900">Estate Planning</h4>
						<p class="mt-2 text-sm text-stone-600">Helping clients develop wills, trusts, and other estate planning documents to ensure their assets are managed and distributed according to their wishes.</p>
					</div>
				</div>
				<a href="/toptierlegal/services" class="mt-6 inline-flex items-center text-sm font-medium text-stone-900 hover:underline">
					View all services →
				</a>
			</div>
		</section>
	</main>
	<TopTierLegalFooter />
</TopTierLegalLayout>
