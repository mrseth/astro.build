---
import TopTierLegalLayout from '~/layouts/TopTierLegalLayout.astro';
import TopTierLegalNav from './_components/TopTierLegalNav.astro';
import TopTierLegalFooter from './_components/TopTierLegalFooter.astro';
---
<TopTierLegalLayout title="Services — Top Tier Legal PLLC" description="Legal services in White Plains, Westchester County, NY: business law, real estate law, estate planning.">
	<TopTierLegalNav />
	<main class="min-h-screen">
		<section class="border-b border-stone-200 bg-white px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
			<div class="mx-auto max-w-5xl">
				<h1 class="text-3xl font-semibold tracking-tight text-stone-900 sm:text-4xl" style="font-family: 'Cormorant Garamond', serif;">Services</h1>
				<p class="mt-2 text-stone-600">Serving White Plains, Westchester County, NY.</p>

				<div class="mt-12 grid gap-10 sm:grid-cols-3">
					<div class="rounded-lg border border-stone-200 bg-stone-50/50 p-6">
						<h2 class="text-lg font-semibold text-stone-900">Business Law</h2>
						<p class="mt-3 text-sm text-stone-600 leading-relaxed">
							Assisting clients with business formation, contract review, compliance matters, and dispute resolution to support smooth and lawful operations.
						</p>
					</div>
					<div class="rounded-lg border border-stone-200 bg-stone-50/50 p-6">
						<h2 class="text-lg font-semibold text-stone-900">Real Estate Law</h2>
						<p class="mt-3 text-sm text-stone-600 leading-relaxed">
							Providing legal support for residential and commercial real estate transactions, including contract drafting, negotiations, and title issues.
						</p>
					</div>
					<div class="rounded-lg border border-stone-200 bg-stone-50/50 p-6">
						<h2 class="text-lg font-semibold text-stone-900">Estate Planning</h2>
						<p class="mt-3 text-sm text-stone-600 leading-relaxed">
							Helping clients develop wills, trusts, and other estate planning documents to ensure their assets are managed and distributed according to their wishes.
						</p>
					</div>
				</div>

				<div class="mt-12 border-t border-stone-200 pt-8">
					<p class="text-sm font-medium text-stone-700">Top Tier Legal PLLC</p>
					<p class="mt-1 text-sm text-stone-600">24 Heatherbloom Road White Plains, NY 10605</p>
					<p class="mt-1 text-sm text-stone-600">
						<a href="mailto:clientcare@toptierlegalpllc.com" class="hover:underline">clientcare@toptierlegalpllc.com</a>
						<span class="text-stone-400">·</span>
						<a href="tel:+18455960430" class="hover:underline">(845) 596-0430</a>
					</p>
				</div>
			</div>
		</section>
	</main>
	<TopTierLegalFooter />
</TopTierLegalLayout>
