---
interface Props { base?: string; contactEmail?: string; }
const { base = '/toptierlegal', contactEmail = 'clientcare@toptierlegalpllc.com' } = Astro.props;
---
<footer class="border-t border-stone-200 bg-stone-100 px-4 py-12 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-6xl">
		<div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
			<div>
				<p class="text-lg font-semibold text-stone-900" style="font-family: 'Cormorant Garamond', serif;">Top Tier Legal PLLC</p>
				<p class="mt-2 max-w-md text-sm text-stone-600">
					Assisting clients with business formation, contract review, compliance matters, and dispute resolution to support smooth and lawful operations.
				</p>
				<p class="mt-2 text-sm text-stone-500">Serving White Plains, Westchester County, NY</p>
				<p class="text-sm text-stone-500">Last updated 02/21/2026</p>
			</div>
			<div>
				<p class="text-sm font-medium text-stone-700">Contact</p>
				<ul class="mt-2 space-y-1 text-sm text-stone-600">
					<li>Email: <a href={`mailto:${contactEmail}`} class="hover:underline">{contactEmail}</a></li>
					<li>Phone: <a href="tel:+18455960430" class="hover:underline">(845) 596-0430</a></li>
					<li>24 Heatherbloom Road White Plains, NY 10605</li>
				</ul>
			</div>
			<div>
				<p class="text-sm font-medium text-stone-700">Quick Links</p>
				<ul class="mt-2 space-y-1 text-sm text-stone-600">
					<li><a href={base + '/'} class="hover:underline">Home</a></li>
					<li><a href={base + '/about'} class="hover:underline">About</a></li>
					<li><a href={base + '/services'} class="hover:underline">Services</a></li>
					<li><a href={base + '/contact'} class="hover:underline">Contact</a></li>
					<li><a href={base + '/privacy'} class="hover:underline">Privacy Policy</a></li>
					<li><a href={base + '/terms'} class="hover:underline">Terms & Conditions</a></li>
					<li><a href={base + '/sms'} class="hover:underline">SMS Program</a></li>
				</ul>
			</div>
		</div>
		<div class="mt-10 border-t border-stone-200 pt-8 text-center text-sm text-stone-500 space-y-1">
			<p>© Top Tier Legal PLLC</p>
			<p>Site built with <a href="https://nebulabrandgroup.com" target="_blank" rel="noopener noreferrer" class="hover:underline">Nebula Brands Group</a></p>
		</div>
	</div>
</footer>
