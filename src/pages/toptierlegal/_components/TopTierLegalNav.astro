---
const base = '/toptierlegal';
---
<header class="sticky top-0 z-50 border-b border-stone-200/80 bg-stone-50/95 backdrop-blur-sm">
	<nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Main">
		<a href={base + '/'} class="text-xl font-semibold text-stone-800" style="font-family: 'Cormorant Garamond', serif;">Top Tier Legal PLLC</a>
		<ul class="flex gap-6 text-sm font-medium text-stone-600 max-sm:gap-4">
			<li><a href={base + '/'} class="hover:text-stone-900">Home</a></li>
			<li><a href={base + '/about'} class="hover:text-stone-900">About</a></li>
			<li><a href={base + '/services'} class="hover:text-stone-900">Services</a></li>
			<li><a href={base + '/contact'} class="hover:text-stone-900">Contact</a></li>
		</ul>
	</nav>
</header>
